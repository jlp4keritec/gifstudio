# ============================================================================
# GifStudio - Configuration de production
# ============================================================================
# IMPORTANT : Ce fichier sera généré automatiquement avec des secrets aléatoires
# par le script bootstrap-vps.ps1. Ne JAMAIS commiter le .env.production réel.
# ============================================================================

# --- URL publique (HTTPS impératif en production) ---
PUBLIC_URL=https://gifstudio.toolspdf.net

# --- PostgreSQL (interne au réseau Docker) ---
POSTGRES_USER=gifstudio
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_STRONG_PASSWORD
POSTGRES_DB=gifstudio

# --- JWT (clé de signature des tokens d'authentification) ---
# Au moins 32 caractères aléatoires
JWT_SECRET=CHANGE_ME_LONG_RANDOM_STRING_AT_LEAST_32_CHARS

# --- Admin initial (créé au premier démarrage) ---
ADMIN_EMAIL=admin@gifstudio.toolspdf.net
ADMIN_PASSWORD=CHANGE_ME_AT_FIRST_LOGIN
FORCE_PASSWORD_CHANGE=true

# --- Storage (chemin sur le VPS pour les fichiers persistants) ---
# Doit exister et être accessible en écriture par Docker
STORAGE_PATH=/var/www/gifstudio/storage
