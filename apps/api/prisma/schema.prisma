// GifStudio - Prisma schema
// Doc: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  moderator
  user
}

model User {
  id                 String   @id @default(uuid()) @db.Uuid
  email              String   @unique @db.VarChar(255)
  passwordHash       String   @map("password_hash") @db.VarChar(255)
  role               UserRole @default(user)
  mustChangePassword Boolean  @default(false) @map("must_change_password")
  isActive           Boolean  @default(true) @map("is_active")
  lastLoginAt        DateTime? @map("last_login_at")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  gifs        Gif[]
  collections Collection[]

  @@map("users")
}

model Gif {
  id            String   @id @default(uuid()) @db.Uuid
  slug          String   @unique @db.VarChar(16)
  title         String   @db.VarChar(255)
  description   String?  @db.Text
  filePath      String   @map("file_path") @db.VarChar(500)
  thumbnailPath String   @map("thumbnail_path") @db.VarChar(500)
  width         Int
  height        Int
  durationMs    Int      @map("duration_ms")
  fps           Int
  fileSize      BigInt   @map("file_size")
  views         Int      @default(0)
  isPublic      Boolean  @default(true) @map("is_public")
  ownerId       String   @map("owner_id") @db.Uuid
  tags          String[] @default([])
  metadata      Json     @default("{}")
  createdAt     DateTime @default(now()) @map("created_at")

  owner       User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  collections CollectionGif[]
  categories  GifCategory[]

  @@index([slug])
  @@index([isPublic, createdAt(sort: Desc)])
  @@index([tags], type: Gin)
  @@map("gifs")
}

model Collection {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(255)
  description String?  @db.Text
  isPublic    Boolean  @default(false) @map("is_public")
  ownerId     String   @map("owner_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  owner User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  gifs  CollectionGif[]

  @@map("collections")
}

model CollectionGif {
  collectionId String   @map("collection_id") @db.Uuid
  gifId        String   @map("gif_id") @db.Uuid
  addedAt      DateTime @default(now()) @map("added_at")

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  gif        Gif        @relation(fields: [gifId], references: [id], onDelete: Cascade)

  @@id([collectionId, gifId])
  @@map("collection_gifs")
}

model Category {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique @db.VarChar(100)
  slug String @unique @db.VarChar(100)

  gifs GifCategory[]

  @@map("categories")
}

model GifCategory {
  gifId      String @map("gif_id") @db.Uuid
  categoryId String @map("category_id") @db.Uuid

  gif      Gif      @relation(fields: [gifId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([gifId, categoryId])
  @@map("gif_categories")
}
